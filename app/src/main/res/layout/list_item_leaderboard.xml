<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/rank_text"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/card_name_text"
            app:layout_constraintBottom_toBottomOf="@id/stats_text"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="1." />

        <TextView
            android:id="@+id/card_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/rating_text"
            app:layout_constraintStart_toEndOf="@id/rank_text"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Awesome Card Name" />

        <TextView
            android:id="@+id/record_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/card_name_text"
            app:layout_constraintTop_toBottomOf="@id/card_name_text"
            tools:text="10W / 2L" />

        <TextView
            android:id="@+id/stats_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/card_name_text"
            app:layout_constraintStart_toStartOf="@+id/card_name_text"
            app:layout_constraintTop_toBottomOf="@id/record_text"
            tools:text="HP:123 ATK:45 DEF:67 SPD:89 LCK:10" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/card_name_text"
            app:layout_constraintBottom_toBottomOf="@id/stats_text"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="1450" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
